# Copy to .env.dev. Cashly npm dev/build/start selects it on dev/develop branches.
# Use CASHLY_ENV or --app-env to override branch selection. Restart after env edits.
# Server-only: never rename these with a NEXT_PUBLIC_ prefix.
# Bot destination: international country code, +country code, or Indonesian 08 format.
# Display separators (spaces, parentheses, hyphens) are normalized on the server.
# The number is absent from Cashly page/bundle; WhatsApp/redirect recipients can see it.
WHATSAPP_BOT_NUMBER=

# Optional pre-filled message. Opening a chat does not send it automatically.
WHATSAPP_CONNECT_MESSAGE=Halo Cashly, saya ingin meminta OTP untuk menghubungkan akun saya.

# OTP verification is still a frontend example. No bot token/real OTP is needed.
# Never put gateway secrets or real OTPs in client configuration.

# Local email/password Auth. FE and BE run in separate host terminals.
APP_ORIGIN=http://localhost:3000
CASHLY_API_ORIGIN=http://127.0.0.1:8000
SUPABASE_URL=http://127.0.0.1:54321
# Same local publishable key as BE, from BE npm run supabase:status.
SUPABASE_PUBLISHABLE_KEY=
