# Copy to .env.prod. Selected on main/master/prod or with --app-env prod.
# Alternatively inject values with CASHLY_ENV=prod CASHLY_ENV_SOURCE=system.
# Server only: no NEXT_PUBLIC_ prefix for the bot number or gateway credentials.
WHATSAPP_BOT_NUMBER=
WHATSAPP_CONNECT_MESSAGE=Halo Cashly, saya ingin meminta OTP untuk menghubungkan akun saya.

# Google OAuth: server-only configuration; no SMTP credentials needed.
APP_ORIGIN=https://cashly.covryzne.dev
CASHLY_API_ORIGIN=https://api.example.invalid
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
