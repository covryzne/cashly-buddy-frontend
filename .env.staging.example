# Copy to .env.staging. Selected on the staging branch or with --app-env staging.
# Only templates are tracked. Real values belong to server/CI secrets.
# NODE_ENV is set by the Next command, not the branch name.
WHATSAPP_BOT_NUMBER=
WHATSAPP_CONNECT_MESSAGE=Halo Cashly, saya ingin meminta OTP untuk menghubungkan akun saya.

# Public app origin used for login callbacks.
APP_ORIGIN=https://staging.cashly.covryzne.dev
# API URL inside Docker. For host-based runs, use the reachable backend origin.
CASHLY_API_ORIGIN=http://backend:8000
# The frontend gets Supabase Auth configuration from the Cashly backend.
