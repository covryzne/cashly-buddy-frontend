{
  "name": "cashly-buddy-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "dev:staging": "node scripts/run-next.mjs dev --app-env staging",
    "build:staging": "node scripts/run-next.mjs build --app-env staging",
    "start:staging": "node scripts/run-next.mjs start --app-env staging",
    "build:prod": "node scripts/run-next.mjs build --app-env prod",
    "start:prod": "node scripts/run-next.mjs start --app-env prod",
    "env:check": "node scripts/run-next.mjs check",
    "test:env": "node --test scripts/tests/environment.test.mjs",
    "lint": "eslint",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "test:e2e": "playwright test",
    "test:offline": "node scripts/run-offline-tests.mjs",
    "test:chat:model": "playwright test --config=playwright.chat-model.config.ts",
    "test:multimodal": "node scripts/run-multimodal-tests.mjs",
    "test:voice:ai": "playwright test --config=playwright.voice-ai.config.ts",
    "test:receipt:ai": "playwright test --config=playwright.receipt.config.ts",
    "test:chat:ai": "playwright test --config=playwright.chat-ai.config.ts",
    "test:oauth": "playwright test --config=playwright.oauth.config.ts",
    "test:email": "playwright test --config=playwright.email.config.ts",
    "test:dev-styles": "node scripts/check-date-time-dev.mjs && node scripts/check-scan-dev.mjs && node scripts/check-chat-dev.mjs && node scripts/check-voice-dev.mjs",
    "mcp:check": "node scripts/query-shadcn-mcp.mjs",
    "test:dev-browser": "node scripts/check-auth-dev.mjs && node scripts/check-ios-autofill-dev.mjs && node scripts/check-voice-dev.mjs",
    "test:dev-autofill": "node scripts/check-ios-autofill-dev.mjs",
    "diagnose:hydration-extension": "node scripts/diagnose-extension-hydration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@splinetool/react-spline": "^4.2.0",
    "@splinetool/runtime": "^2.0.183",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "date-fns": "^4.4.0",
    "loading-dev": "0.3.8",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-datepicker": "^9.1.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
